# PaySentry free-tier deployment reference.
# Put real values in Render's server-side environment settings, never in this file.
SPRING_PROFILES_ACTIVE=prod
PORT=10000

# TiDB Cloud Starter Free: use the host, database, and prefixed username from Connect.
# TLS is mandatory; do not use useSSL=false or switch to a Scalable/paid instance.
PAYSENTRY_DB_URL=jdbc:mysql://<tidb-host>:4000/<database>?sslMode=VERIFY_IDENTITY&serverTimezone=UTC
PAYSENTRY_DB_USERNAME=<tidb-instance-prefix>.<database-user>
PAYSENTRY_DB_PASSWORD=<set-in-render-secret-settings>
PAYSENTRY_DB_POOL_SIZE=2
PAYSENTRY_DB_MIN_IDLE=0

# Generate independent random values; keep stable between backend deployments.
PAYSENTRY_JWT_SECRET=<base64-secret-at-least-32-bytes>
PAYSENTRY_JWT_EXPIRATION_MS=900000
PAYSENTRY_REFRESH_TOKEN_EXPIRATION_DAYS=30
PAYSENTRY_MOCK_BANK_KEY=<random-secret>
PAYSENTRY_CORS_ALLOWED_ORIGINS=https://<actual-dashboard-domain>.onrender.com

# Leave provider integrations disabled until their credentials/consent are configured.
PAYSENTRY_SEED_ADMIN_ENABLED=false
PAYSENTRY_GMAIL_ENABLED=false
PAYSENTRY_GMAIL_CLIENT_ID=
PAYSENTRY_GMAIL_CLIENT_SECRET=
PAYSENTRY_GMAIL_REDIRECT_URI=
PAYSENTRY_CREDENTIAL_ENCRYPTION_KEY=
PAYSENTRY_FCM_ENABLED=false
PAYSENTRY_FCM_SERVICE_ACCOUNT_PATH=

# React Static Site build variables (set on the dashboard's Render build environment).
VITE_API_BASE_URL=https://<actual-api-domain>.onrender.com/api
VITE_WEBSOCKET_URL=wss://<actual-api-domain>.onrender.com/ws
